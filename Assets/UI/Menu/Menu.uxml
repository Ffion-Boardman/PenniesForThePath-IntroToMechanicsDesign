<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Menu/MenuStyles.uss?fileID=7433441132597879392&amp;guid=079756d58745046449d83bf1ac49cc63&amp;type=3#MenuStyles" />
    <ui:VisualElement name="Page" style="flex-grow: 1;">
        <ui:VisualElement name="Menu" style="flex-grow: 0; top: 40%; align-items: center; justify-content: center; align-self: center; align-content: center; background-color: rgb(89, 89, 89); padding-left: 60px; padding-right: 60px; padding-top: 10px; padding-bottom: 20px;">
            <ui:Label text="Main Menu" name="MainMenulbl" style="-unity-text-align: upper-center; color: rgb(255, 255, 255); padding-bottom: 10px; -unity-font-style: bold;" />
            <ui:VisualElement name="ButtonContainter" style="flex-grow: 1; width: 150%;">
                <ui:Button text="Play" name="Playbtn" class="button" />
                <ui:Button text="Exit" name="Exitbtn" class="button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
